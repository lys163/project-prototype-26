# Local-only credentials. Copy this file to .env and supply your own values.
# Do not commit the resulting .env file.

DB_USERNAME=
DB_PASSWORD=

JWT_SECRET=

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Keep the MinIO server-root and Backend client credentials distinct.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Required only when the optional external AI service is available locally.
GEMINI_API_KEY=

# Required only when running the host-oriented Compose monitoring service.
GF_SECURITY_ADMIN_USER=
GF_SECURITY_ADMIN_PASSWORD=
